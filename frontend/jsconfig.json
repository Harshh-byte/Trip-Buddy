{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "checkJs": true,
    "types": ["vite/client"]
  },
  "exclude": ["node_modules", "**/node_modules/*"]
}
